# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
# local vitest TEMP redirect used inside the sandbox; regenerable worker junk
.tmp-vitest/
# local npm --cache redirect used inside the sandbox; regenerable
.npm-cache/
# local open-next build temp redirect used inside the sandbox; regenerable
.tmp-opennext/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
ehthumbs.db
*.pem
*.log
logs/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# editors / os
.idea/
.vscode/*

# typescript
*.tsbuildinfo
next-env.d.ts

# opennext-cloudflare
/.open-next/
/.wrangler/
# generated Excalidraw self-hosted assets (rebuilt from node_modules on
# predev/prebuild/prebuild:worker); never commit the output
/public/excalidraw-assets/
# generated by `npm run cf-typegen` (needs local sockets - run outside the
# sandbox); never hand-commit a copy
cloudflare-env.d.ts
