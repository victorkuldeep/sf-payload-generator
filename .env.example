# Default Salesforce API version (user can override in the UI)
NEXT_PUBLIC_DEFAULT_SF_API_VERSION=v66.0

# Public app URL (used for metadata; set to your Vercel URL in production)
# NEXT_PUBLIC_APP_URL=https://sf-payload-studio.vercel.app

# Optional: restrict which Salesforce hosts are allowed (comma-separated patterns)
# SF_ALLOWED_HOSTS=*.my.salesforce.com,*.sandbox.my.salesforce.com
